# Telegram bot token from @BotFather (use a separate token for local testing)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# Your Telegram user ID (admin for feed commands)
TELEGRAM_ADMIN_USER_ID=123456789

# OpenAI API key for daily digest summarization
OPENAI_API_KEY=sk-...

# Default timezone for parsing and display (IANA name)
TIMEZONE=Asia/Singapore

# Daily digest local time (HH:MM, 24h)
DIGEST_TIME=08:00

# When true, send a short message if there are no new RSS items
DIGEST_SEND_EMPTY=false

# Global RSS poll interval in minutes (per-feed override in DB not required for v1)
RSS_POLL_INTERVAL_MINUTES=30

# Path to SQLite database file (inside container use /data/bot.db)
DATABASE_PATH=/data/bot.db

# Telegram supergroup chat ID for daily RSS digest (/digest on|off in that group only)
# Get it with /chatid (admin) after adding the bot to the group
DIGEST_GROUP_CHAT_ID=

# TypeSafe Jev for complex reminder parsing (optional)
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_CONFIDENCE_AUTO=0.85
JEV_CONFIDENCE_MIN=0.60
JEV_TIMEOUT_SECONDS=30

# Delete inactive reminder rows older than N days (0 = keep forever)
REMINDER_RETENTION_DAYS=90

# Delete scheduler audit log rows older than N days (0 = keep forever)
SCHEDULER_AUDIT_RETENTION_DAYS=30
